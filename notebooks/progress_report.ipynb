    "print((df.groupby(\"is_night\")[\"hit_and_run\"].mean() * 100).round(2))\n",
    "\n",
    "table = pd.crosstab(df[\"is_night\"], df[\"hit_and_run\"])\n",
    "chi2, p, dof, expected = chi2_contingency(table)\n",
    "print(\"chi2 =\", round(chi2, 1), \"| p =\", p)\n"
