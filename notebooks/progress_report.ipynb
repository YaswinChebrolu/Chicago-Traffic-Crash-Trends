    "# ML analysis 2 (Yaswin Chebrolu): forecast daily crash counts\n",
    "from sklearn.linear_model import LinearRegression\n",
    "from sklearn.ensemble import RandomForestRegressor\n",
    "from sklearn.metrics import mean_absolute_error\n",
    "\n",
    "test_year = data[\"year\"].max()\n",
    "train = data[data[\"year\"] < test_year]\n",
    "test = data[data[\"year\"] == test_year]\n",
    "\n",
    "WEATHER = [\"temp_c\", \"precip_mm\", \"snow_cm\"]\n",
    "def make_X(frame, extra=()):\n",
    "    X = frame[WEATHER + list(extra) + [\"dow\", \"month\"]].copy()\n",
    "    return pd.get_dummies(X, columns=[\"dow\", \"month\"], dtype=float)\n",
    "\n",
    "preds = {\n",
    "    \"Baseline: previous 7-day average\": test[\"prev7_avg\"],\n",
    "    \"Baseline: overall training average\": pd.Series(train[\"crashes\"].mean(), index=test.index),\n",
    "}\n",
    "\n",
    "X_tr, X_te = make_X(train), make_X(test)\n",
    "X_te = X_te.reindex(columns=X_tr.columns, fill_value=0)\n",
    "preds[\"Linear regression (weather + calendar)\"] = pd.Series(\n",
    "    LinearRegression().fit(X_tr, train[\"crashes\"]).predict(X_te), index=test.index)\n",
    "rf = RandomForestRegressor(n_estimators=300, min_samples_leaf=5, random_state=42, n_jobs=-1).fit(X_tr, train[\"crashes\"])\n",
    "preds[\"Random forest (weather + calendar)\"] = pd.Series(rf.predict(X_te), index=test.index)\n",
    "\n",
    "X_tr2, X_te2 = make_X(train, [\"prev7_avg\"]), make_X(test, [\"prev7_avg\"])\n",
    "X_te2 = X_te2.reindex(columns=X_tr2.columns, fill_value=0)\n",
    "rf2 = RandomForestRegressor(n_estimators=300, min_samples_leaf=5, random_state=42, n_jobs=-1).fit(X_tr2, train[\"crashes\"])\n",
    "preds[\"Random forest (weather + calendar + prev 7-day avg)\"] = pd.Series(rf2.predict(X_te2), index=test.index)\n",
    "\n",
    "mean_daily = test[\"crashes\"].mean()\n",
    "summary = pd.Series({k: mean_absolute_error(test[\"crashes\"], v) for k, v in preds.items()},\n",
    "                    name=\"MAE (crashes/day)\").sort_values().to_frame()\n",
    "summary[\"MAE as % of average day\"] = (summary[\"MAE (crashes/day)\"] / mean_daily * 100).round(1)\n",
    "summary[\"MAE (crashes/day)\"] = summary[\"MAE (crashes/day)\"].round(1)\n",
    "print(\"Average crashes per day in the test year:\", round(mean_daily, 1))\n",
    "print(summary)\n",
    "\n",
    "summary[\"MAE (crashes/day)\"].sort_values(ascending=False).plot.barh(figsize=(8, 4))\n",
    "plt.title(\"Prediction error on the test year (lower is better)\")\n",
    "plt.xlabel(\"Mean absolute error (crashes per day)\")\n",
    "plt.tight_layout()\n",
