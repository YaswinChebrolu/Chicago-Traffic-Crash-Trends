   "source": [
    "# Viz 3 (Yaswin Chebrolu): crashes and severity by weather condition\n",
    "import requests\n",
    "\n",
    "# Count crashes per day (drop the last 14 days, which are still being reported)\n",
    "df[\"date\"] = df[\"crash_date\"].dt.normalize()\n",
    "daily = df.groupby(\"date\").size().rename(\"crashes\").to_frame()\n",
    "daily = daily.reindex(pd.date_range(daily.index.min(), daily.index.max(), freq=\"D\"), fill_value=0)\n",
    "daily.index.name = \"date\"\n",
    "daily = daily.iloc[:-14]\n",
    "\n",
    "# Daily weather for Chicago O'Hare from Open-Meteo (free). Saved so it only downloads once.\n",
    "weather_file = path.parent / \"chicago_weather.csv\"\n",
    "if weather_file.exists():\n",
    "    weather = pd.read_csv(weather_file, parse_dates=[\"date\"])\n",
    "else:\n",
    "    r = requests.get(\"https://archive-api.open-meteo.com/v1/archive\", params={\n",
    "        \"latitude\": 41.9742, \"longitude\": -87.9073,\n",
    "        \"start_date\": daily.index.min().strftime(\"%Y-%m-%d\"),\n",
    "        \"end_date\": daily.index.max().strftime(\"%Y-%m-%d\"),\n",
    "        \"daily\": \"temperature_2m_mean,precipitation_sum,snowfall_sum\",\n",
    "        \"timezone\": \"America/Chicago\"}, timeout=60)\n",
    "    r.raise_for_status()\n",
    "    d = r.json()[\"daily\"]\n",
    "    weather = pd.DataFrame({\"date\": pd.to_datetime(d[\"time\"]), \"temp_c\": d[\"temperature_2m_mean\"],\n",
    "                            \"precip_mm\": d[\"precipitation_sum\"], \"snow_cm\": d[\"snowfall_sum\"]})\n",
    "    weather.to_csv(weather_file, index=False)\n",
    "\n",
    "# Join weather to daily crash counts\n",
    "data = daily.join(weather.set_index(\"date\"), how=\"inner\").dropna()\n",
    "data[\"dow\"] = data.index.day_of_week\n",
    "data[\"month\"] = data.index.month\n",
    "data[\"year\"] = data.index.year\n",
    "data[\"prev7_avg\"] = data[\"crashes\"].shift(1).rolling(7).mean()\n",
    "data = data.dropna()\n",
    "\n",
    "# Left and right charts: crash count and severe rate by weather condition\n",
    "w = df.copy()\n",
    "w[\"weather_condition\"] = w[\"weather_condition\"].astype(str).str.upper().str.strip()\n",
    "w = w[~w[\"weather_condition\"].isin([\"UNKNOWN\", \"OTHER\", \"NAN\", \"\"])]\n",
    "by_wx = (w.groupby(\"weather_condition\")\n",
    "           .agg(crashes=(\"severe\", \"size\"), severe_pct=(\"severe\", lambda s: s.mean() * 100))\n",
    "           .query(\"crashes >= 300\").sort_values(\"crashes\"))\n",
    "overall = w[\"severe\"].mean() * 100\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(15, 6), sharey=True)\n",
    "axes[0].barh(by_wx.index, by_wx[\"crashes\"])\n",
    "axes[0].set_xscale(\"log\")\n",
    "axes[0].set_title(\"Crashes by weather condition (log scale)\")\n",
    "axes[0].set_xlabel(\"Number of crashes\")\n",
    "axes[1].barh(by_wx.index, by_wx[\"severe_pct\"])\n",
    "axes[1].axvline(overall, color=\"black\", linestyle=\"--\", label=f\"Overall: {overall:.2f}%\")\n",
    "axes[1].set_title(\"Percent of crashes that were severe\")\n",
    "axes[1].set_xlabel(\"Severe crashes (%)\")\n",
    "axes[1].legend()\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "print(by_wx.round(2))\n",
    "\n",
    "# Average crashes per day on dry, rain, and snow days\n",
    "def weather_group(row):\n",
    "    if row[\"snow_cm\"] >= 0.5:\n",
    "        return \"Snow day\"\n",
    "    if row[\"precip_mm\"] >= 1:\n",
    "        return \"Rain day\"\n",
    "    return \"Dry day\"\n",
    "\n",
    "data[\"wx_group\"] = data.apply(weather_group, axis=1)\n",
    "per_day = (data.groupby(\"wx_group\")[\"crashes\"].agg([\"mean\", \"count\"])\n",
    "           .rename(columns={\"mean\": \"avg crashes per day\", \"count\": \"days\"})\n",
    "           .reindex([\"Dry day\", \"Rain day\", \"Snow day\"]))\n",
    "per_day[\"avg crashes per day\"].plot.bar(figsize=(6, 4), rot=0)\n",
    "plt.title(\"Average crashes per day by weather\")\n",
    "plt.ylabel(\"Crashes per day\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "print(per_day.round(1))"
   ]
