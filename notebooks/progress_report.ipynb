    "# Viz 5 (Salwa)\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.stats import chi2_contingency\n",
    "\n",
    "\n",
    "# Viz 5 (Salwa): hit and run share by hour of day\n",
    "hr = df.groupby(\"crash_hour\")[\"hit_and_run\"].mean() * 100\n",
