     "output_type": "stream",
     "text": [
      "lighting_condition | chi2 = 1125.0 | p = 2.8722636276054842e-242 | Cramer's V = 0.035\n",
      "posted_speed_limit | chi2 = 1089.2 | p = 2.543260338333816e-202 | Cramer's V = 0.034\n",
      "weather_condition | chi2 = 114.1 | p = 8.104018172414318e-20 | Cramer's V = 0.011\n"
     ]
    }
   ],
   "source": [
    "# Chi square tests (Salwa)\n",
    "def chi_test(col):\n",
    "    table = pd.crosstab(df[col], df[\"severe\"])\n",
    "    chi2, p, dof, expected = chi2_contingency(table)\n",
    "    n = table.to_numpy().sum()\n",
    "    cramers_v = (chi2 / (n * (min(table.shape) - 1))) ** 0.5\n",
    "    return chi2, p, cramers_v\n",
    "\n",
    "for col in [\"lighting_condition\", \"posted_speed_limit\", \"weather_condition\"]:\n",
    "    chi2, p, v = chi_test(col)\n",
    "    print(col, \"| chi2 =\", round(chi2, 1), \"| p =\", p, \"| Cramer's V =\", round(v, 3))"
   ]
  },
